{
  "name": "qosthub-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.e2e.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ../../packages/contracts/openapi.json --output ../../packages/contracts/api.generated.ts",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "openapi-typescript": "7.13.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "@playwright/test": "1.63.0",
    "jsdom": "28.1.0"
  }
}
