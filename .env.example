# Copy to .env at the repository root. External tokens remain optional for T01/T02.
APP_NAME=НарядAI API
APP_TIMEZONE=Asia/Qostanay
PUBLIC_BASE_URL=http://localhost:5173
# Compose: postgresql+psycopg://qosthub:URL_ENCODED_PASSWORD@db:5432/qosthub_demo
# Native API: use localhost instead of db. Compose requires both values below.
POSTGRES_PASSWORD=
DATABASE_URL=
SESSION_SECRET=

# T06: create the bot with BotFather; username without @. Keep token local.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Generate a random base64url secret (1-256 A-Z/a-z/0-9/_/- characters).
TELEGRAM_WEBHOOK_SECRET=
OPENAI_API_KEY=
# T07: keys are checked lazily; no key keeps AI jobs visibly blocked.
AI_MODEL=gpt-6.1-sol
AI_LIGHT_MODEL=gpt-6-luna
AI_COMPLEX_MODEL=gpt-6-astra
AI_REASONING_EFFORT=medium
AI_LIGHT_REASONING_EFFORT=low
AI_COMPLEX_REASONING_EFFORT=medium
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=4096
AI_COMPLEX_MAX_OUTPUT_TOKENS=8192
AI_REVIEW_LEASE_SECONDS=180
AI_REVIEW_SNAPSHOT_RESTARTS=2
AI_REVIEW_POLL_SECONDS=1
PHOTO_STORAGE_PATH=data/photos
# T16 optional local Whisper v3 service. No OpenAI speech API or audio storage.
# Native: http://127.0.0.1:8016. Leave URL/token empty to disable transcription.
SPEECH_SERVICE_URL=
SPEECH_SERVICE_TOKEN=
SPEECH_REQUEST_TIMEOUT_SECONDS=90
# Absolute native model directory prepared with app.modules.speech.prepare_model.
SPEECH_MODEL_PATH=
SPEECH_DEVICE=cpu
SPEECH_COMPUTE_TYPE=int8
# Host model directory mounted by compose.speech.yaml (separate from container path).
SPEECH_MODEL_DIR=
# Local HTTP only. Use true with HTTPS outside local development.
SESSION_COOKIE_SECURE=false

# T10 optional HTTPS overlay: exact Quick Tunnel hostname, no scheme/port/path.
TUNNEL_HOSTNAME=
# Demonstration day, YYYY-MM-DD. New dated seeds require a fresh isolated demo DB.
DEMO_AS_OF=
# Seed password is configured locally or entered interactively; never commit it.
DEMO_PASSWORD=
